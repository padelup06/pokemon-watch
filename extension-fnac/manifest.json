{
  "manifest_version": 3,
  "name": "Pokémon Watch — Fnac",
  "version": "1.0.4",
  "description": "Surveille vos fiches Fnac dans votre propre navigateur et vous alerte sur Discord quand un produit revient en stock.",
  "permissions": ["alarms", "storage", "tabs", "scripting", "notifications"],
  "host_permissions": ["https://www.fnac.com/*", "https://discord.com/api/webhooks/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Pokémon Watch — Fnac", "default_popup": "options.html" },
  "icons": { "128": "icon.png" }
}
